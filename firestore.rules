rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function getUserRoles() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles; }
    function hasRole(role) { return isSignedIn() && getUserRoles().hasAny([role]); }
    function isAdmin() { return hasRole('ADMIN') || request.auth.token.email == 'sonalisjs37@gmail.com'; }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'roles']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.roles is list && data.roles.size() <= 10;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['token', 'email', 'assignedRoles', 'status']) &&
             data.token is string && data.token.size() <= 128 &&
             data.assignedRoles is list && data.assignedRoles.size() >= 1;
    }

    function isValidPrayerCell(data) {
      return data.keys().hasAll(['name', 'type', 'memberIds']) &&
             data.name is string && data.name.size() <= 100 &&
             data.memberIds is list && data.memberIds.size() <= 500;
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['cellId', 'date', 'attendance']) &&
             data.cellId is string &&
             data.attendance is map;
    }

    // --- Rules ---

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidUser(incoming()) && (
        incoming().roles.hasOnly(['CELL_MEMBER']) || isAdmin()
      );
      allow update: if isVerified() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'prayerCellIds'])) ||
        isAdmin()
      );
    }

    // Invites
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (existing().email == request.auth.token.email || isAdmin());
      allow create: if isVerified() && isValidInvite(incoming()) && (
        isAdmin() || hasRole('PRAYER_CELL_SECRETARY')
      );
      allow delete: if isAdmin();
    }

    // Prayer Cells
    match /prayerCells/{cellId} {
      function isMember() { return isSignedIn() && (request.auth.uid in existing().memberIds); }
      function isCellAdmin() { return isSignedIn() && (request.auth.uid in existing().parentIds || request.auth.uid in existing().leaderIds); }
      function isCommittee() { return hasRole('PRAYER_CELL_SECRETARY') || hasRole('SENIOR_ADVISOR') || isAdmin(); }

      allow read: if isMember() || isCommittee();
      allow create: if isVerified() && isValidPrayerCell(incoming()) && (hasRole('PRAYER_CELL_SECRETARY') || isAdmin());
      allow update: if isVerified() && (
        isAdmin() || 
        (hasRole('PRAYER_CELL_SECRETARY') && isValidPrayerCell(incoming())) ||
        (isCellAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'place', 'category']))
      );
    }

    // Meetings
    match /prayerCells/{cellId}/meetings/{meetingId} {
      function cellData() { return get(/databases/$(database)/documents/prayerCells/$(cellId)).data; }
      function isCellAdmin() { return isSignedIn() && (request.auth.uid in cellData().parentIds || request.auth.uid in cellData().leaderIds); }

      allow read: if isSignedIn() && (request.auth.uid in cellData().memberIds || isAdmin());
      allow create: if isVerified() && isCellAdmin() && isValidMeeting(incoming());
      allow update: if isVerified() && (
        (isCellAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'attendance', 'venue', 'time', 'meetLink'])) ||
        // Self-attendance mark
        (request.auth.uid in cellData().memberIds && incoming().diff(existing()).affectedKeys().hasOnly(['attendance']) && 
         incoming().attendance[request.auth.uid] == true)
      );
    }

    // Messages
    match /prayerCells/{cellId}/messages/{messageId} {
      function isCellMember() { return request.auth.uid in get(/databases/$(database)/documents/prayerCells/$(cellId)).data.memberIds; }
      allow read, create: if isVerified() && (isCellMember() || isAdmin());
    }

    // Committee Records (Restricted to roles)
    match /committee/{document=**} {
      function isCommitteeMember() { 
        return getUserRoles().hasAny(['SENIOR_ADVISOR', 'PRESIDENT', 'SECRETARY', 'TREASURER', 'PRAYER_SECRETARY', 'PRAYER_CELL_SECRETARY', 'ADMIN']);
      }
      allow read: if isVerified() && isCommitteeMember();
      
      // Fine-grained write access
      match /finances/records/{recordId} {
        allow write: if isVerified() && (hasRole('TREASURER') || isAdmin());
      }
      match /events/records/{eventId} {
        allow write: if isVerified() && (hasRole('PRESIDENT') || isAdmin());
      }
      match /records/colleges {
        allow write: if isVerified() && isCommitteeMember();
      }
      match /records/annualPlan {
        allow write: if isVerified() && isCommitteeMember();
      }
      match /chat/messages/{messageId} {
        allow read, create: if isVerified() && isCommitteeMember();
      }
    }

    // Quiet Times
    match /users/{userId}/quietTimes/{qtId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || existing().isShared == true);
      allow write: if isVerified() && request.auth.uid == userId;
    }
  }
}
