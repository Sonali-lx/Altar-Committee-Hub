rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function getUserRoles() { 
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles 
        : []; 
    }
    function hasRole(role) { return isSignedIn() && getUserRoles().hasAny([role]); }
    function isAdmin() { return hasRole('ADMIN') || request.auth.token.email == 'sonalisjs37@gmail.com'; }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'roles']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.roles is list && data.roles.size() <= 10;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['token', 'email', 'assignedRoles', 'status']) &&
             data.token is string && data.token.size() <= 128 &&
             data.assignedRoles is list && data.assignedRoles.size() >= 1;
    }

    function isValidPrayerCell(data) {
      return data.keys().hasAll(['name', 'memberIds']) &&
             data.name is string && data.name.size() <= 100 &&
             data.memberIds is list && data.memberIds.size() <= 500;
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['cellId', 'date', 'attendance']) &&
             data.cellId is string &&
             data.attendance is map;
    }

    // --- Rules ---

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidUser(incoming()) && (
        incoming().roles.hasOnly(['CELL_MEMBER']) || isAdmin()
      );
      allow update: if isVerified() && (
        (request.auth.uid == userId && !('roles' in incoming().diff(existing()).affectedKeys())) ||
        isAdmin()
      );
    }

    // Event Collections
    match /eventCollections/{collectionId} {
      allow read: if isSignedIn();
      allow write: if isVerified() && (hasRole('SECRETARY') || isAdmin() || hasRole('PRESIDENT') || hasRole('SENIOR_ADVISOR') || hasRole('CELL_LEADER') || hasRole('CELL_PARENT'));
    }

    // Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && (hasRole('SECRETARY') || isAdmin() || hasRole('PRESIDENT') || hasRole('SENIOR_ADVISOR') || hasRole('CELL_LEADER') || hasRole('CELL_PARENT'));
      allow update: if isSignedIn();
      allow delete: if isVerified() && (hasRole('SECRETARY') || isAdmin() || hasRole('PRESIDENT') || hasRole('SENIOR_ADVISOR') || hasRole('CELL_LEADER') || hasRole('CELL_PARENT'));
    }

    match /colleges/{collegeId} {
      allow read: if isSignedIn();
      allow write: if isVerified() && (hasRole('SECRETARY') || isAdmin() || hasRole('PRESIDENT') || hasRole('SENIOR_ADVISOR') || hasRole('CELL_LEADER') || hasRole('CELL_PARENT'));
    }

    match /membershipRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isVerified() && (hasRole('SECRETARY') || isAdmin() || hasRole('PRESIDENT') || hasRole('SENIOR_ADVISOR') || hasRole('CELL_LEADER') || hasRole('CELL_PARENT'));
    }

    // Invites
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (existing().email == request.auth.token.email || isAdmin());
      allow create: if isVerified() && isValidInvite(incoming()) && (
        isAdmin() || hasRole('PRAYER_CELL_SECRETARY')
      );
      allow delete: if isAdmin();
    }

    // Prayer Cells
    match /prayerCells/{cellId} {
      function isMember() { return isSignedIn() && ('memberIds' in existing() && request.auth.uid in existing().memberIds); }
      function isCellAdmin() { 
        return isSignedIn() && (
          ('parentIds' in existing() && request.auth.uid in existing().parentIds) || 
          ('leaderIds' in existing() && request.auth.uid in existing().leaderIds)
        ); 
      }
      function isCommittee() { return hasRole('PRAYER_CELL_SECRETARY') || hasRole('SENIOR_ADVISOR') || isAdmin(); }

      allow read: if isSignedIn();
      allow create: if isVerified() && isValidPrayerCell(incoming()) && (hasRole('PRAYER_CELL_SECRETARY') || isAdmin());
      allow update: if isVerified() && (
        isAdmin() || 
        (hasRole('PRAYER_CELL_SECRETARY') && isValidPrayerCell(incoming())) ||
        (isCellAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'location', 'isOnline', 'studyType', 'genderType', 'meetingDay', 'meetingTime', 'leaderName', 'leaderEmail', 'parentName', 'parentEmail'])) ||
        // Self-join logic for members (fallback if they're joining)
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds']))
      );
    }

    // Meetings
    match /prayerCells/{cellId}/meetings/{meetingId} {
      function cellData() { return get(/databases/$(database)/documents/prayerCells/$(cellId)).data; }
      function isCellAdmin() { 
        let data = cellData();
        return isSignedIn() && (
          ('parentIds' in data && request.auth.uid in data.parentIds) || 
          ('leaderIds' in data && request.auth.uid in data.leaderIds)
        ); 
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Messages
    match /prayerCells/{cellId}/messages/{messageId} {
      function isCellMember() { 
        let data = get(/databases/$(database)/documents/prayerCells/$(cellId)).data;
        return ('memberIds' in data && request.auth.uid in data.memberIds) || isAdmin();
      }
      function isCellAdmin() { 
        let data = get(/databases/$(database)/documents/prayerCells/$(cellId)).data;
        return isSignedIn() && (
          ('parentIds' in data && request.auth.uid in data.parentIds) || 
          ('leaderIds' in data && request.auth.uid in data.leaderIds)
        ); 
      }
      allow read, create: if isSignedIn() && isCellMember();
      allow update: if isSignedIn() && existing().senderId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || isAdmin() || isCellAdmin());
    }

    // Prayers
    match /dawnDuskPrayers/{docId} {
      allow read: if isSignedIn();
      allow write: if isVerified();
    }
    
    // Community Feed
    match /communityFeed/{postId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isVerified() && resource.data.authorId == request.auth.uid);
    }
    
    // Community Chat
    match /communityChat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /committeeChat/{messageId} {
      function isCommitteeMember() { 
        return getUserRoles().hasAny(['SENIOR_ADVISOR', 'PRESIDENT', 'SECRETARY', 'TREASURER', 'PRAYER_SECRETARY', 'PRAYER_CELL_SECRETARY', 'ADMIN']);
      }
      allow read, create: if isSignedIn() && (isCommitteeMember() || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // Settings
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isVerified() && (hasRole('PRAYER_SECRETARY') || isAdmin() || hasRole('PRESIDENT'));
    }

    // Committee Records (Restricted to roles)
    match /committee/{document=**} {
      function isCommitteeMember() { 
        return getUserRoles().hasAny(['SENIOR_ADVISOR', 'PRESIDENT', 'SECRETARY', 'TREASURER', 'PRAYER_SECRETARY', 'PRAYER_CELL_SECRETARY', 'ADMIN']);
      }
      allow read: if isVerified() && isCommitteeMember();
      
      // Fine-grained write access
      match /finances/records/{recordId} {
        allow write: if isVerified() && (hasRole('TREASURER') || isAdmin());
      }
      match /events/records/{eventId} {
        allow write: if isVerified() && (hasRole('PRESIDENT') || isAdmin());
      }
      match /records/colleges {
        allow write: if isVerified() && isCommitteeMember();
      }
      match /records/annualPlan {
        allow write: if isVerified() && isCommitteeMember();
      }
      match /chat/messages/{messageId} {
        allow read, create: if isVerified() && isCommitteeMember();
      }
    }

    // Quiet Times
    match /quietTimes/{qtId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && existing().userId == request.auth.uid;
    }

    // Prayers
    match /prayers/{prayerId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && existing().userId == request.auth.uid;
    }

    // Calendar Notes
    match /calendarNotes/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update: if isVerified() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isVerified() && existing().userId == request.auth.uid;
    }

    // Join Requests
    match /joinRequests/{requestId} {
      function isOwner() {
        return isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      }
      function isCellAdmin() {
        let cellId = (resource != null) ? resource.data.cellId : incoming().cellId;
        let cell = get(/databases/$(database)/documents/prayerCells/$(cellId)).data;
        return isSignedIn() && (
          hasRole('PRAYER_CELL_SECRETARY') ||
          isAdmin() ||
          ('parentIds' in cell && request.auth.uid in cell.parentIds) ||
          ('leaderIds' in cell && request.auth.uid in cell.leaderIds)
        );
      }

      allow read: if isOwner() || isCellAdmin();
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && (isOwner() || isCellAdmin());
    }

    // Journals
    match /journals/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
